{
    "name": "kzxl/lite-inertia",
    "description": "Zero-dependency Inertia.js protocol adapter for Slim 4 and PSR-7/PSR-15 applications.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kzxl/LiteInertia",
    "support": {
        "issues": "https://github.com/kzxl/LiteInertia/issues",
        "source": "https://github.com/kzxl/LiteInertia"
    },
    "authors": [
        {
            "name": "Phong Vo",
            "email": "phong.vo@kzxl.com"
        }
    ],
    "keywords": [
        "inertia",
        "inertiajs",
        "inertia-v2",
        "deferred-props",
        "merge-props",
        "react",
        "vue",
        "svelte",
        "slim4",
        "psr7",
        "psr15",
        "spa"
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "LiteInertia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteInertia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
